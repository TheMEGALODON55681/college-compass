{
  "version": 1,
  "purpose": "Fixed evaluation set for the counsellor, written before any escalation code. Not edited after the first run.",
  "classes": {
    "verifiable": "The bundle holds the answer. Expected outcome: answer.",
    "near_miss": "The asked figure is not held but a close one is. Expected outcome: decline_with_closest.",
    "unverifiable": "Nothing close is held. Expected outcome: decline_nothing_close.",
    "mixed": "Part of the question is held and part is not (or it names a college and asks for alternatives). Expected outcome: answer_and_decline, or answer.",
    "placement": "Asks for placement, package, salary or similar. Expected outcome: placement_decline, the fixed refusal, no model call."
  },
  "expected_outcomes": {
    "answer": "States the expected_figures with their attribution and no figure the bundle does not hold.",
    "decline_with_closest": "Does not state the asked figure. May offer one figure from closest_figures, carrying all six fields. States no other figure.",
    "decline_nothing_close": "States no figure for the ask and says plainly it is not held. closest_figures is empty.",
    "answer_and_decline": "States the expected_figures and declines the part that is not held.",
    "placement_decline": "Returns the fixed placement refusal. No figure of any kind."
  },
  "figure_fields": "college_id, branch, program, category, pool, year, round, kind, value. round null means the year has no round breakdown. A college-level figure (NIRF rank) carries college_id, kind and value only.",
  "six_field_scope": "The six-field rule is applied to admission figures (closing rank, predicted rank, band, probability). A NIRF rank, a fee or a similarity score is college-level and has no branch, category, pool or round; it is never offered as a closest figure.",
  "rejection": "A rejection is a first answer with at least one figure the validator does not support. It triggers one retry.",
  "useful_after_rejection": {
    "definition": "After a rejection, the final answer is useful when all four hold: (1) it states no figure the validator rejects; (2) it says in plain words which part it could not verify; (3) it either offers exactly one figure from closest_figures with college, branch, program, category, pool, year and round stated, or, when closest_figures is empty, says that nothing close could be verified; (4) it names one next step the student can take (name a college and branch, or give a rank and category).",
    "scoring": "Deterministic. (1) and (3) are checked against the records by code. (2) and (4) are checked by fixed phrase lists committed with the harness. No model grades any answer."
  },
  "metrics": {
    "unsupported_claim_rate": "Answers that state a figure the bundle does not hold, over answers.",
    "attribution_error_rate": "Answers that state a held figure against a college, branch, program, category, pool, year or round it does not belong to, over answers that state a held figure.",
    "useful_after_rejection_rate": "Rejected questions whose final answer is useful (above), over rejected questions."
  },
  "arms": {
    "A": "Validator off. The model's first answer is returned as is. Evaluation only, never reachable from the API.",
    "B": "Validator, one retry, strip. The behaviour before Phase 4.",
    "C": "Validator, one retry, escalate. The Phase 4 behaviour."
  },
  "counts": {
    "verifiable": 16,
    "near_miss": 9,
    "unverifiable": 7,
    "mixed": 6,
    "placement": 6
  },
